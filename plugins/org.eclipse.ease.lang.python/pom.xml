  <parent>
    <groupId>org.eclipse.python4capella</groupId>
    <artifactId>org.eclipse.python4capella.parent</artifactId>
    <relativePath>../..</relativePath>
    <version>1.5.0-SNAPSHOT</version>
  </parent>
  <groupId>org.eclipse.python4capella</groupId>
